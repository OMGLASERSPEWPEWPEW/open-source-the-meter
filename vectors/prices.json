    "anthropic": "https://platform.claude.com/docs/en/about-claude/pricing",
    "openai": "https://developers.openai.com/api/docs/pricing"
  },
  "rules": {
    "anthropic": "Cache writes cost 1.25x input for the 5-minute cache and 2x for the 1-hour cache; cache reads are listed per model. Fast mode and US-only inference multiply a request's whole token cost (fast_percent, us_geo_percent). Web search costs $10 per 1,000 searches.",
    "openai": "input_tokens includes cached and cache-write tokens; output_tokens includes reasoning tokens. Above long_context.above_input_tokens of input, the whole request is priced at the long_context rates. A model with cache_write null prices cache writes as plain input."
  },
  "web_search_per_1000": {
    "anthropic": 10
  },
